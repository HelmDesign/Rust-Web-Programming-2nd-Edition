{
  "name": "Rust Web Programming",
  "dockerfile": "Dockerfile",
  "context": "..",
  
  // Build arguments
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Container configuration
  "remoteUser": "devuser",
  "workspaceFolder": "/workspace",

  // Mount the local directory into the container
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/devuser/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/devuser/.gitconfig,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  // VS Code Extensions
  "customizations": {
    "vscode": {
      "extensions": [
        // Rust
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates",
        "fill-labs.dependi",
        
        // Web Development
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "xabikos.JavaScriptSnippets",
        
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        
        // Docker
        "ms-azuretools.vscode-docker",
        
        // Terraform
        "hashicorp.terraform",
        "hashicorp.hcl",
        
        // General Development Tools
        "eamodio.gitlens",
        "GitHub.copilot",
        "ms-vscode.remote-explorer",
        "ms-vscode-remote.remote-containers",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "ms-azuretools.vscode-apimanagement",
        "humao.rest-client",
        "rangav.vscode-thunder-client",
        
        // Code Quality
        "SonarSource.sonarlint-vscode",
        
        // Markdown
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        // Rust settings
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        },
        "rust-analyzer.checkOnSave.command": "clippy",
        "rust-analyzer.checkOnSave.extraArgs": [
          "--all-targets",
          "--all-features",
          "--",
          "-W",
          "clippy::all"
        ],
        
        // Python settings
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        },
        "python.linting.enabled": true,
        "python.linting.ruffEnabled": true,
        "python.testing.pytestEnabled": true,
        
        // JavaScript/Node settings
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        
        // Terraform settings
        "[hcl]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        },
        
        // General editor settings
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.rulers": [80, 100, 120],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.wordWrap": "on",
        "editor.minimap.enabled": false,
        
        // Terminal settings
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          }
        }
      }
    }
  },

  // Port forwarding
  "forwardPorts": [
    3000,     // Node.js default
    5000,     // Python Flask default
    8000,     // Python Django default
    8080,     // General web service
    8443,     // HTTPS
    3000,     // Postman Newman default
    5432,     // PostgreSQL
    6379,     // Redis
    27017,    // MongoDB
    9090      // Prometheus/Grafana
  ],

  "portsAttributes": {
    "3000": { "label": "Application", "onAutoForward": "notify" },
    "5000": { "label": "Flask", "onAutoForward": "notify" },
    "8000": { "label": "Django", "onAutoForward": "notify" },
    "8080": { "label": "Web Service", "onAutoForward": "notify" },
    "8443": { "label": "HTTPS", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "notify" },
    "6379": { "label": "Redis", "onAutoForward": "notify" },
    "27017": { "label": "MongoDB", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus", "onAutoForward": "notify" }
  },

  // Environment variables
  "remoteEnv": {
    "RUST_LOG": "debug",
    "PYTHONUNBUFFERED": "1",
    "NODE_ENV": "development"
  },

  // Post-create command
  "postCreateCommand": "echo 'DevContainer initialized successfully!' && rustc --version && node --version && python3 --version && docker --version && terraform --version",

  // Features (optional - uncomment to use pre-built features)
  // "features": {
  //   "ghcr.io/devcontainers/features/git:1": {},
  //   "ghcr.io/devcontainers/features/github-cli:1": {}
  // }

  // Lifecycle scripts
  "onCreateCommand": "echo 'Setting up development environment...'",
  "updateContentCommand": "rustup update && cargo update",
  "waitFor": "onCreateCommand"
}