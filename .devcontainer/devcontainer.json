{
  "name": "Rust Web Programming",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates",
        "fill-labs.dependi",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "xabikos.JavaScriptSnippets",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform",
        "hashicorp.hcl",
        "eamodio.gitlens",
        "GitHub.copilot",
        "ms-vscode.remote-explorer",
        "ms-vscode-remote.remote-containers",
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "ms-azuretools.vscode-apimanagement",
        "humao.rest-client",
        "rangav.vscode-thunder-client",
        "SonarSource.sonarlint-vscode",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        },
        "rust-analyzer.checkOnSave.command": "clippy",
        "rust-analyzer.checkOnSave.extraArgs": [
          "--all-targets",
          "--all-features",
          "--",
          "-W",
          "clippy::all"
        ],
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        },
        "python.linting.enabled": true,
        "python.linting.ruffEnabled": true,
        "python.testing.pytestEnabled": true,
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[hcl]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.rulers": [80, 100, 120],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "editor.wordWrap": "on",
        "editor.minimap.enabled": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          }
        }
      }
    }
  },
  "forwardPorts": [
    3000,
    5000,
    8000,
    8080,
    8443,
    5432,
    6379,
    27017,
    9090
  ],
  "portsAttributes": {
    "3000": { "label": "Application", "onAutoForward": "notify" },
    "5000": { "label": "Flask", "onAutoForward": "notify" },
    "8000": { "label": "Django", "onAutoForward": "notify" },
    "8080": { "label": "Web Service", "onAutoForward": "notify" },
    "8443": { "label": "HTTPS", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "notify" },
    "6379": { "label": "Redis", "onAutoForward": "notify" },
    "27017": { "label": "MongoDB", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus", "onAutoForward": "notify" }
  },
  "remoteEnv": {
    "RUST_LOG": "debug",
    "PYTHONUNBUFFERED": "1",
    "NODE_ENV": "development"
  },
  "postCreateCommand": ". $HOME/.cargo/env && echo 'DevContainer initialized successfully!' && rustc --version && node --version && python3 --version && docker --version && terraform --version",
  "onCreateCommand": "echo 'Setting up development environment...'",
  "updateContentCommand": "source $HOME/.cargo/env && rustup update && cargo update",
  "waitFor": "onCreateCommand"
}